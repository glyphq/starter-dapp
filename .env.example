# Public origin bound into Glyph Connect requests and wallet metadata.
# Must be a credential-free, public HTTPS origin with no path, query, or fragment.
# Leave blank to use the current browser origin. Overrides must match the page.
NEXT_PUBLIC_APP_ORIGIN=

# Optional public WalletConnect project ID. Leave blank to keep WalletConnect disabled.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
